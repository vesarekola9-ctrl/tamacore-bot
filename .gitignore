# ================================
# TamaCore Bot - Full .gitignore
# ================================

# ----------------
# Python
# ----------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyc.*
*.pkl

# Virtual environments
.venv/
venv/
env/
ENV/

# Python build
build/
dist/
*.egg-info/
pip-wheel-metadata/

# ----------------
# Logs
# ----------------
*.log
logs/

# ----------------
# Temporary files
# ----------------
*.tmp
*.temp
*.bak
*.swp
*.swo

# ----------------
# Local generated content
# ----------------
output/
generated/
dist_console/
tmp/
temp/

# TamaCore factory generated game
tamacore-game/
.factory_assets/

# build zip files
*.zip

# ----------------
# Node / Cordova / Android
# ----------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

platforms/
plugins/

# Android build cache
.gradle/
local.properties
*.keystore
*.jks

# Android output
app/build/
*.apk
*.aab

# ----------------
# IDE / Editors
# ----------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ----------------
# OS files
# ----------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------
# Secrets
# ----------------
.env
.env.*
secrets.json
play-store-key.json
